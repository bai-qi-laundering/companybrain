TABLET_BIND=0.0.0.0
TABLET_PORT=8790
# Host publish address is set in compose.yaml (LAN 192.168.123.201:8790 and loopback for a local proxy).
# Leave empty for LAN `/`, and when the HTTPS proxy (for example Tailscale Funnel)
# strips the mount prefix before forwarding. Set this only when the proxy
# forwards the public prefix unchanged. Example placeholder:
# /cam-xxxxxxxxxxxxxxxx
TABLET_PATH_PREFIX=
