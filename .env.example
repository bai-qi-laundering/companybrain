# 只在 NAS 本機設定，切勿提交 GitHub。
# 密碼請用英文字母與數字，避免 Compose 的 $、# 等特殊字元解析問題。
DB_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHARACTERS
ADMIN_USER=admin1
ADMIN_PASSWORD=CHANGE_ME_TO_AT_LEAST_16_CHARACTERS
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
# 首次只在公司內網測試。把 192.168.1.100 改為你的 NAS 區網 IP。
PUBLIC_ORIGIN=http://192.168.1.100:8788
APP_BIND=0.0.0.0
APP_PORT=8788
COOKIE_SECURE=false
# 正式外網：APP_BIND=127.0.0.1；PUBLIC_ORIGIN=https://你的專用網址；COOKIE_SECURE=true
